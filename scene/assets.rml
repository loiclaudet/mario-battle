<Rive version="1" kind="fragment">
    <!-- every image is nearest sampled (samplerFilter 1) so pixel art stays crisp at any scale.
         ids: 8:1xx stage, 8:2xx sprites, 8:8xx audio, 8:9xx scripts (modules first). -->


        <!-- the components' data: each placement in game.rml binds one of these -->
        <ViewModelPropertyViewModel viewModelReferenceId="9:950" name="overlay" id="9:254"/>
        <ViewModelPropertyViewModel viewModelReferenceId="9:900" name="menu" id="9:255"/>
        <!-- one hud slot per player, each its own HudSlot instance -->
        <ViewModelPropertyViewModel viewModelReferenceId="9:800" name="hud1" id="9:250"/>
        <ViewModelPropertyViewModel viewModelReferenceId="9:800" name="hud2" id="9:251"/>
        <ViewModelPropertyViewModel viewModelReferenceId="9:800" name="hud3" id="9:252"/>
        <ViewModelPropertyViewModel viewModelReferenceId="9:800" name="hud4" id="9:253"/>
        <ViewModelInstance exports="true" name="Default" id="9:201">
            <ViewModelInstanceEnum propertyValue="9:101" viewModelPropertyId="9:210" id="9:220"/>
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="9:214" id="9:224"/>
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="9:215" id="9:225"/>
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="9:216" id="9:226"/>
            <ViewModelInstanceViewModel propertyValue="9:951" viewModelPropertyId="9:254" id="9:264"/>

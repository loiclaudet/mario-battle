<Rive version="1" kind="fragment">
    <!-- view models are the contract between scripts/game.luau (writer) and the markup (reader).
         ids: 9:1xx enums, 9:2xx Game, 9:3xx Player, 9:4xx Enemy, 9:5xx Pow, 9:6xx Fireball, 9:7xx MenuCursor. -->

    <DataEnumCustom name="Phase" id="9:100">
        <DataEnumValue key="title" value="Title" id="9:101"/>
        <DataEnumValue key="playing" value="Playing" id="9:102"/>
        <DataEnumValue key="over" value="Over" id="9:103"/>
    </DataEnumCustom>

    <DataEnumCustom name="Winner" id="9:110">

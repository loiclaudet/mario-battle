        <DataEnumValue key="walkB" value="Walk B" id="9:124"/>
        <DataEnumValue key="flipped" value="Flipped" id="9:122"/>
        <DataEnumValue key="dying" value="Dying" id="9:123"/>
    </DataEnumCustom>

    <ViewModel defaultInstanceId="9:201" name="Game" id="9:200">

                    <StateTransition stateToId="0:521" duration="0" id="0:523">
                        <TransitionViewModelCondition opValue="equal" id="0:61848">
                            <TransitionPropertyViewModelComparator id="0:61849">
                                <BindablePropertyEnum id="0:61850">
                                    <DataBindContext sourcePathIds="9:200-9:210" propertyKey="637" id="0:61851"/>

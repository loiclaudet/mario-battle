            <Image assetId="8:30000" x="0" y="112" originX="0" originY="0" name="stub_l" id="0:208"/>
            <Image assetId="8:52755" x="224" y="112" originX="0" originY="0" name="stub_r" id="0:209"/>
            <Image assetId="8:60735" x="0" y="160" originX="0" originY="0" name="ledge_ll" id="0:210"/>
            <Image assetId="8:56988" x="160" y="160" originX="0" originY="0" name="ledge_lr" id="0:211"/>
            <Image assetId="8:6166" x="0" y="176" originX="0" originY="0" name="pipe_bl" id="0:212"/>
            <Image assetId="8:5269" x="224" y="176" originX="0" originY="0" name="pipe_br" id="0:213"/>
            <Image assetId="8:2606" x="0" y="208" originX="0" originY="0" name="floor" id="0:214"/>
        </Node>

        <!-- one frame animations, one per overlay state -->
        <LinearAnimation loopValue="loop" duration="1" name="Title Show" id="0:601">
            <KeyedObject objectId="0:430"><KeyedProperty propertyKey="296"><KeyFrameId value="0:432" frame="0"/></KeyedProperty></KeyedObject>
        </LinearAnimation>
        <LinearAnimation loopValue="loop" duration="1" name="Title Hide" id="0:602">

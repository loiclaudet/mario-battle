<Rive version="1" kind="fragment">
    <!-- Game artboard: the nes framebuffer, 256x240. earlier siblings draw on top, so the order is
         overlay component (pause and winner banners), the menu component in the Title solo, the playfield script
         (players, enemies, fireballs, pow), the hud (four HudSlot components, under the sprites), the stage (one
         component per layout in scene/stages, the Stage layer shows the one a round plays).
         the components live in scene/components and bind to their own view model through the placement's
         dataBindPathIds (Game.overlay, Game.menu, Game.hudN). ids: 0:1xx layout, 0:2xx stage, 0:3xx hud,
         0:4xx overlay, 0:5xx state machine, 0:6xx animations; 0:61xxx are the coop ids the first push wrote. -->
    <Artboard defaultStateMachineId="0:500" viewModelId="9:200" viewModelInstanceId="9:201" clip="true" width="256" height="240" styleId="0:101" x="0" y="0" name="Game" id="0:100">
        <Fill name="Background" id="0:61780">
            <SolidColor colorValue="FF000000" name="Black" id="0:61781"/>
        </Fill>
        <LayoutComponentStyle name="Game Style" id="0:101"/>

        <!-- overlays: the pause and winner banners, on top of everything -->
        <Node name="Overlay" id="0:400">
            <NestedArtboard artboardId="12:100" dataBindPathIds="9:200-9:254" x="0" y="0" name="OverlayView" id="0:61996"/>
            <!-- the start menu component, shown by the Phase layer while the round is not on -->
            <Solo activeComponentId="0:432" name="Title" id="0:430">
                <Node name="none" id="0:431"/>
                <NestedArtboard artboardId="11:100" dataBindPathIds="9:200-9:255" x="0" y="0" name="MenuView" id="0:432"/>
            </Solo>
        </Node>

        <!-- playfield: the simulation. fill sized so resize gets 256x240 and local coords equal artboard coords -->
        <LayoutComponent width="256" height="240" styleId="0:111" name="Playfield Layout" id="0:110">
            <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fill" widthUnitsValue="auto" heightUnitsValue="auto" name="Playfield Style" id="0:111"/>
            <ScriptedLayout scriptAssetId="8:990" name="Playfield" id="0:112">
                <FocusData id="0:61814"/>
                <ScriptInputArtboard artboardId="1:100" name="playerArtboard" id="0:61815"/>
                <ScriptInputArtboard artboardId="2:100" name="spinyArtboard" id="0:61816"/>
                <ScriptInputArtboard artboardId="3:100" name="flyArtboard" id="0:61817"/>
                <ScriptInputArtboard artboardId="4:100" name="crabArtboard" id="0:61818"/>
                <ScriptInputArtboard artboardId="5:100" name="powArtboard" id="0:61819"/>
                <ScriptInputArtboard artboardId="6:100" name="fireballArtboard" id="0:61820"/>
                <ScriptInputViewModelProperty dataBindPathIds="9:200-9:254" name="overlayVm" id="0:61986"/>
                <ScriptInputViewModelProperty dataBindPathIds="9:200-9:255" name="menuVm" id="0:61987"/>
                <ScriptInputViewModelProperty dataBindPathIds="9:200-9:255-9:910" name="cursor1" id="0:61988"/>
                <ScriptInputViewModelProperty dataBindPathIds="9:200-9:255-9:911" name="cursor2" id="0:61989"/>
                <ScriptInputViewModelProperty dataBindPathIds="9:200-9:255-9:912" name="cursor3" id="0:61990"/>
                <ScriptInputViewModelProperty dataBindPathIds="9:200-9:255-9:913" name="cursor4" id="0:61991"/>
                <ScriptInputViewModelProperty dataBindPathIds="9:200-9:250" name="hudSlot1" id="0:61992"/>
                <ScriptInputViewModelProperty dataBindPathIds="9:200-9:251" name="hudSlot2" id="0:61993"/>
                <ScriptInputViewModelProperty dataBindPathIds="9:200-9:252" name="hudSlot3" id="0:61994"/>
                <ScriptInputViewModelProperty dataBindPathIds="9:200-9:253" name="hudSlot4" id="0:61995"/>
                <ScriptInputViewModelProperty dataBindPathIds="9:200-9:256" name="stage1" id="0:62030"/>
                <ScriptInputViewModelProperty dataBindPathIds="9:200-9:257" name="stage2" id="0:62031"/>
                <ScriptInputViewModelProperty dataBindPathIds="9:200-9:258" name="stage3" id="0:62032"/>
                <ScriptInputViewModelProperty dataBindPathIds="9:200-9:259" name="stage4" id="0:62033"/>
            </ScriptedLayout>
        </LayoutComponent>

        <!-- hud: one HudSlot component per player, below the playfield so a player jumping through the top row passes
             in front of the coins; y bound to shakeY like the stage, hidden with the stage on the title -->
        <Node name="Hud" id="0:300">
            <DataBindContext sourcePathIds="9:200-9:214" propertyKey="14" id="0:61975"/>
            <NestedArtboard artboardId="10:100" dataBindPathIds="9:200-9:250" x="8" y="0" name="HudSlot1" id="0:61976"/>
            <NestedArtboard artboardId="10:100" dataBindPathIds="9:200-9:251" x="68" y="0" name="HudSlot2" id="0:61977"/>
            <NestedArtboard artboardId="10:100" dataBindPathIds="9:200-9:252" x="128" y="0" name="HudSlot3" id="0:61978"/>
            <NestedArtboard artboardId="10:100" dataBindPathIds="9:200-9:253" x="188" y="0" name="HudSlot4" id="0:61979"/>
        </Node>

        <!-- the stages: one component per layout (scene/stages), the Stage layer shows the one Game.stage names.
             y bound to shakeY for the pow shake, hidden by the title animations -->
        <Solo activeComponentId="0:61997" name="Stages" id="0:200">
            <DataBindContext sourcePathIds="9:200-9:214" propertyKey="14" id="0:61821"/>
            <NestedArtboard artboardId="21:100" dataBindPathIds="9:200-9:256" x="0" y="0" name="Stage1" id="0:61997"/>
            <NestedArtboard artboardId="22:100" dataBindPathIds="9:200-9:257" x="0" y="0" name="Stage2" id="0:61998"/>
        </Solo>

        <!-- one frame animations: the title solo, and the stage and hud hidden with it so the menu is the black screen
             the rom draws -->
        <LinearAnimation loopValue="loop" duration="1" name="Title Show" id="0:601">
            <KeyedObject objectId="0:430" id="0:61822"><KeyedProperty propertyKey="296" id="0:61823"><KeyFrameId value="0:432" frame="0" id="0:61824"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="0:200" id="0:61947"><KeyedProperty propertyKey="18" id="0:61948"><KeyFrameDouble value="0" frame="0" id="0:61949"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="0:300" id="0:61980"><KeyedProperty propertyKey="18" id="0:61981"><KeyFrameDouble value="0" frame="0" id="0:61982"/></KeyedProperty></KeyedObject>
        </LinearAnimation>
        <LinearAnimation loopValue="loop" duration="1" name="Title Hide" id="0:602">
            <KeyedObject objectId="0:430" id="0:61825"><KeyedProperty propertyKey="296" id="0:61826"><KeyFrameId value="0:431" frame="0" id="0:61827"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="0:200" id="0:61950"><KeyedProperty propertyKey="18" id="0:61951"><KeyFrameDouble value="1" frame="0" id="0:61952"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="0:300" id="0:61983"><KeyedProperty propertyKey="18" id="0:61984"><KeyFrameDouble value="1" frame="0" id="0:61985"/></KeyedProperty></KeyedObject>
        </LinearAnimation>

        <LinearAnimation loopValue="loop" duration="1" name="Stage 1" id="0:612">
            <KeyedObject objectId="0:200" id="0:62020"><KeyedProperty propertyKey="296" id="0:62021"><KeyFrameId value="0:61997" frame="0" id="0:62022"/></KeyedProperty></KeyedObject>
        </LinearAnimation>
        <LinearAnimation loopValue="loop" duration="1" name="Stage 2" id="0:613">
            <KeyedObject objectId="0:200" id="0:62023"><KeyedProperty propertyKey="296" id="0:62024"><KeyFrameId value="0:61998" frame="0" id="0:62025"/></KeyedProperty></KeyedObject>
        </LinearAnimation>

        <StateMachine name="Game" id="0:500">
            <!-- Stage: which stage component is shown, from Game.stage -->
            <StateMachineLayer name="Stage" id="0:580">
                <AnyState x="60" y="-100" id="0:581"/>
                <ExitState x="560" y="-100" id="0:582"/>
                <EntryState x="0" y="0" id="0:583">
                    <StateTransition stateToId="0:585" id="0:584"/>
                </EntryState>
                <AnimationState animationId="0:612" x="160" y="0" id="0:585">
                    <StateTransition stateToId="0:586" duration="0" id="0:62000">
                        <TransitionViewModelCondition opValue="equal" id="0:62001">
                            <TransitionPropertyViewModelComparator id="0:62002">
                                <BindablePropertyNumber id="0:62003">
                                    <DataBindContext sourcePathIds="9:200-9:218" propertyKey="636" id="0:62004"/>
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="2" id="0:62005"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState animationId="0:613" x="320" y="0" id="0:586">
                    <StateTransition stateToId="0:585" duration="0" id="0:62010">
                        <TransitionViewModelCondition opValue="equal" id="0:62011">
                            <TransitionPropertyViewModelComparator id="0:62012">
                                <BindablePropertyNumber id="0:62013">
                                    <DataBindContext sourcePathIds="9:200-9:218" propertyKey="636" id="0:62014"/>
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="1" id="0:62015"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>
            <StateMachineLayer name="Phase" id="0:510">
                <AnyState x="60" y="-100" id="0:511"/>
                <ExitState x="560" y="-100" id="0:512"/>
                <EntryState x="0" y="0" id="0:513">
                    <StateTransition stateToId="0:520" id="0:514"/>
                </EntryState>
                <AnimationState animationId="0:601" x="160" y="0" id="0:520">
                    <StateTransition stateToId="0:522" duration="0" id="0:528">
                        <TransitionViewModelCondition opValue="equal" id="0:61843">
                            <TransitionPropertyViewModelComparator id="0:61844">
                                <BindablePropertyEnum id="0:61845">
                                    <DataBindContext sourcePathIds="9:200-9:210" propertyKey="637" id="0:61846"/>

<Rive version="1" kind="fragment">
    <!-- Game artboard: the nes framebuffer, 256x240. earlier siblings draw on top, so the order is
         overlay, hud coin fills, playfield script, stage strips.
         ids: 0:1xx layout, 0:2xx stage, 0:3xx hud, 0:4xx overlay, 0:5xx state machine, 0:6xx animations, 0:7xx converters. -->
    <Artboard defaultStateMachineId="0:500" viewModelId="9:200" viewModelInstanceId="9:201" clip="true" width="256" height="240" styleId="0:101" x="0" y="0" name="Game" id="0:100">
        <Fill name="Background">
            <SolidColor colorValue="FF000000" name="Black"/>
        </Fill>
        <LayoutComponentStyle name="Game Style" id="0:101"/>

        <!-- overlay: title panel and winner banner, each a Solo the state machine switches -->
        <Node name="Overlay" id="0:400">
            <Solo activeComponentId="0:411" name="Winner" id="0:410">
                <Node name="none" id="0:411"/>
                <Node name="mario" id="0:412">
                <Text x="128" y="124" sizingValue="autoWidth" originX="0.5" originY="0" name="MarioWins" id="0:415">
                    <TextStylePaint fontSize="8" fontAssetId="8:850" name="Style" id="0:416">
                        <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="White"/></Fill>
                    </TextStylePaint>
                    <TextValueRun styleId="0:416" text="MARIO WINS" name="Run" id="0:417"/>
                </Text>

                    <Shape x="0" y="120" name="Band" id="0:414">
                        <Rectangle width="256" height="24" originX="0" originY="0" name="Rect"/>
                        <Fill name="Fill"><SolidColor colorValue="FF000000" name="Black"/></Fill>
                    </Shape>
                </Node>
                <Node name="luigi" id="0:413">
                <Text x="128" y="124" sizingValue="autoWidth" originX="0.5" originY="0" name="LuigiWins" id="0:419">
                    <TextStylePaint fontSize="8" fontAssetId="8:850" name="Style" id="0:420">
                        <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="White"/></Fill>
                    </TextStylePaint>
                    <TextValueRun styleId="0:420" text="LUIGI WINS" name="Run" id="0:421"/>
                </Text>

                    <Shape x="0" y="120" name="Band" id="0:418">
                        <Rectangle width="256" height="24" originX="0" originY="0" name="Rect"/>
                        <Fill name="Fill"><SolidColor colorValue="FF000000" name="Black"/></Fill>
                    </Shape>
                </Node>
            </Solo>
            <Solo activeComponentId="0:432" name="Title" id="0:430">
                <Node name="none" id="0:431"/>
                <Node name="panel" id="0:432">
                <Text x="128" y="116" sizingValue="autoWidth" originX="0.5" originY="0" name="TitleText" id="0:434">
                    <TextStylePaint fontSize="8" fontAssetId="8:850" name="Style" id="0:435">
                        <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="White"/></Fill>
                    </TextStylePaint>
                    <TextValueRun styleId="0:435" text="MARIO BATTLE" name="Run" id="0:436"/>
                </Text>
                <Text x="128" y="136" sizingValue="autoWidth" originX="0.5" originY="0" name="TitleHint" id="0:437">
                    <TextStylePaint fontSize="8" fontAssetId="8:850" name="Style" id="0:438">
                        <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="White"/></Fill>
                    </TextStylePaint>
                    <TextValueRun styleId="0:438" text="PRESS JUMP" name="Run" id="0:439"/>
                </Text>

                    <Shape x="0" y="108" name="Band" id="0:433">
                        <Rectangle width="256" height="48" originX="0" originY="0" name="Rect"/>
                        <Fill name="Fill"><SolidColor colorValue="FF000000" name="Black"/></Fill>
                    </Shape>
                </Node>
            </Solo>
        </Node>

        <!-- hud: five coin fills per player, opacity 0 or 1 from coinsP1/coinsP2 through the slot range mappers -->
        <Node name="Hud" id="0:300">
            <Image assetId="8:60009" x="72" y="16" originX="0" originY="0" opacity="0" name="p1_coin_1" id="0:301">
                <DataBindContext sourcePathIds="9:200-9:212" propertyKey="18" converterId="0:701"/>
            </Image>
            <Image assetId="8:60009" x="80" y="16" originX="0" originY="0" opacity="0" name="p1_coin_2" id="0:302">

--!strict
local Stage = require('scripts/stage')

return function(): Tests
    return function(test: Tester)
        test.group('tiles', function()
            test.case('floor is solid from y 208, air above it', function(expect)
                expect(Stage.solidAt(100, 208)).is(true)
                expect(Stage.solidAt(100, 239)).is(true)
                expect(Stage.solidAt(100, 207)).is(false)
            end)
            test.case('ledges and the gap between them', function(expect)
                expect(Stage.solidAt(95, 48)).is(true)
                expect(Stage.solidAt(96, 48)).is(false)
                expect(Stage.solidAt(159, 55)).is(false)
                expect(Stage.solidAt(160, 55)).is(true)
                expect(Stage.solidAt(64, 96)).is(true)
                expect(Stage.solidAt(63, 96)).is(false)
                expect(Stage.solidAt(191, 111)).is(true)
                expect(Stage.solidAt(192, 111)).is(false)
                expect(Stage.solidAt(31, 112)).is(true)
                expect(Stage.solidAt(32, 112)).is(false)
                expect(Stage.solidAt(224, 127)).is(true)
                expect(Stage.solidAt(0, 160)).is(true)
                expect(Stage.solidAt(255, 175)).is(true)
                expect(Stage.solidAt(128, 160)).is(false)
            end)
            test.case('pipes are not solid', function(expect)
                expect(Stage.solidAt(8, 20)).is(false)
                expect(Stage.solidAt(240, 190)).is(false)
            end)
            test.case('x wraps, y does not', function(expect)
                expect(Stage.solidAt(256 + 10, 48)).is(true)
                expect(Stage.solidAt(-10, 48)).is(true)
                expect(Stage.solidAt(10, -5)).is(false)
                expect(Stage.solidAt(10, 240)).is(false)
                expect(Stage.wrapX(260)).is(4)
                expect(Stage.wrapX(-1)).is(255)
            end)
            test.case('tile edges', function(expect)
                expect(Stage.tileTopAt(70, 100)).is(96)
                expect(Stage.tileBottomAt(70, 100)).is(104)
                expect(Stage.tileTopAt(70, 90)).is(nil)
            end)
        end)
        test.group('pow', function()
            test.case('shrinks with each hit and disappears after three', function(expect)
                local r0 = Stage.powRect(0)
                local r1 = Stage.powRect(1)
                local r2 = Stage.powRect(2)
                assert(r0 and r1 and r2)
                expect(r0.h).is(15)
                expect(r0.y).is(152)
                expect(r1.h).is(12)
                expect(r1.y).is(152)
                expect(r2.h).is(10)
                expect(r2.y).is(152)
                expect(Stage.powRect(3)).is(nil)
            end)
        end)
    end
end

--!strict
local Menu = require('scripts/menu')
local Input = require('scripts/input')

type Keys = { [string]: boolean }

local function intent(keys: Keys): Input.Intent
    return {
        left = keys.left == true,
        right = keys.right == true,
        up = keys.up == true,
        down = keys.down == true,
        jump = keys.jump == true,
        run = keys.run == true,
        start = keys.start == true,
    }
end

local NONE = intent({})

local function nothing(m: Menu.State): { Input.Intent }
    local intents: { Input.Intent } = {}
    for i = 1, #m.slots do
        intents[i] = NONE
    end
    return intents
end

-- one press by one slot: a frame with the key held, then a frame released. returns the held frame's events
local function press(m: Menu.State, slot: number, key: string): Menu.Events
    local intents = nothing(m)
    intents[slot] = intent({ [key] = true })
    local ev = Menu.update(m, intents)
    Menu.update(m, nothing(m))
    return ev
end

return function(): Tests
    return function(test: Tester)
        test.group('cursors', function()
            test.case('p1 starts on mario, p2 on luigi, nothing locked', function(expect)
                local m = Menu.new(2)
                expect(m.slots[1].focus).is(1)
                expect(m.slots[2].focus).is(2)
                expect(Menu.controllerFor(m, 1)).is(nil)
                expect(Menu.controllerFor(m, 2)).is(nil)
                expect(Menu.isLocked(m, 1)).is(false)
            end)
            test.case('left and right move between the cards and stop at the ends', function(expect)
                local m = Menu.new(2)
                expect(press(m, 1, 'right').moved).is(true)
                expect(m.slots[1].focus).is(2)
                press(m, 1, 'right')
                press(m, 1, 'right')
                expect(m.slots[1].focus).is(4)
                expect(press(m, 1, 'right').moved).is(false)
                expect(m.slots[1].focus).is(4)
                press(m, 1, 'left')
                press(m, 1, 'left')
                expect(press(m, 1, 'left').moved).is(true)
                expect(m.slots[1].focus).is(1)
                expect(press(m, 1, 'left').moved).is(false)
            end)
            test.case('down goes to START, up returns to the card last focused', function(expect)
                local m = Menu.new(2)
                press(m, 1, 'right')
                expect(press(m, 1, 'down').moved).is(true)
                expect(m.slots[1].focus).is(Menu.START)
                expect(press(m, 1, 'left').moved).is(false)
                expect(press(m, 1, 'up').moved).is(true)
                expect(m.slots[1].focus).is(2)
            end)
            test.case('a held button is one press', function(expect)
                local m = Menu.new(2)
                local intents = nothing(m)
                intents[1] = intent({ right = true })
                expect(Menu.update(m, intents).moved).is(true)
                expect(Menu.update(m, intents).moved).is(false)
                expect(m.slots[1].focus).is(2)
            end)
        end)

        test.group('locks', function()
            test.case('jump on a card locks it and drops the cursor to START', function(expect)
                local m = Menu.new(2)
                local ev = press(m, 1, 'jump')
                expect(ev.locked).is(true)
                expect(ev.launch).is(false)
                expect(m.slots[1].locked).is(1)
                expect(m.slots[1].focus).is(Menu.START)
                expect(Menu.controllerFor(m, 1)).is(1)
                expect(Menu.isLocked(m, 1)).is(true)
            end)
            test.case('jump on your own locked card unlocks it, the cursor stays', function(expect)
                local m = Menu.new(2)
                press(m, 1, 'jump')
                press(m, 1, 'up')
                local ev = press(m, 1, 'jump')
                expect(ev.unlocked).is(true)
                expect(m.slots[1].locked).is(0)
                expect(m.slots[1].focus).is(1)
                expect(Menu.controllerFor(m, 1)).is(nil)
            end)
            test.case('a card taken by the other player refuses', function(expect)
                local m = Menu.new(2)
                press(m, 1, 'jump')
                press(m, 2, 'left')
                local ev = press(m, 2, 'jump')
                expect(ev.refused).is(true)
                expect(ev.locked).is(false)
                expect(m.slots[2].locked).is(0)
                expect(m.slots[2].focus).is(1)
                expect(Menu.controllerFor(m, 1)).is(1)
            end)
            test.case('locking another card moves your lock', function(expect)
                local m = Menu.new(2)
                press(m, 1, 'jump')
                press(m, 1, 'up')
                press(m, 1, 'right')
                expect(press(m, 1, 'jump').locked).is(true)
                expect(Menu.controllerFor(m, 1)).is(nil)
                expect(Menu.controllerFor(m, 2)).is(1)
            end)
        end)

        test.group('launch', function()
            test.case('jump on START launches with nobody locked: four cpus', function(expect)
                local m = Menu.new(2)
                press(m, 1, 'down')
                expect(press(m, 1, 'jump').launch).is(true)
                for card = 1, 4 do
                    expect(Menu.roleFor(m, card)).is('cpu')
                end
                expect(Menu.onCount(m)).is(4)
            end)
            test.case('the run button on a free card turns it off and on, never below two cards on', function(expect)
                local m = Menu.new(2)
                press(m, 1, 'right') -- p1 on luigi
                expect(press(m, 1, 'run').toggled).is(true)
                expect(Menu.roleFor(m, 2)).is('off')
                press(m, 1, 'right')
                press(m, 1, 'run') -- wario off
                expect(Menu.onCount(m)).is(2)
                press(m, 1, 'right')
                expect(press(m, 1, 'run').refused).is(true) -- waluigi would leave one card on
                expect(Menu.roleFor(m, 4)).is('cpu')
                press(m, 1, 'left')
                expect(press(m, 1, 'run').toggled).is(true) -- wario back on
                expect(Menu.roleFor(m, 3)).is('cpu')
                -- a human taking an off card turns it on, and a locked card cannot be turned off
                press(m, 2, 'left') -- p2 from luigi to mario... luigi is off, p2 starts on it
                expect(Menu.roleFor(m, 2)).is('off')
                press(m, 2, 'right')
                expect(press(m, 2, 'jump').locked).is(true)
                expect(Menu.roleFor(m, 2)).is(2)
                press(m, 1, 'left') -- p1 on luigi, p2's card
                expect(press(m, 1, 'run').refused).is(true)
            end)
            test.case('one lock: that player, the other cards are cpus', function(expect)
                local m = Menu.new(2)
                press(m, 1, 'jump')
                expect(press(m, 1, 'jump').launch).is(true)
                expect(Menu.roleFor(m, 1)).is(1)
                expect(Menu.roleFor(m, 2)).is('cpu')
                expect(Menu.roleFor(m, 4)).is('cpu')
            end)
            test.case('two locks, p2 took mario: the slots are swapped', function(expect)
                local m = Menu.new(2)
                press(m, 2, 'left')
                press(m, 2, 'jump')
                press(m, 1, 'right')
                press(m, 1, 'jump')
                expect(press(m, 2, 'jump').launch).is(true)
                expect(Menu.controllerFor(m, 1)).is(2)
                expect(Menu.controllerFor(m, 2)).is(1)
            end)
            test.case('the start button launches from anywhere', function(expect)
                local m = Menu.new(2)
                expect(press(m, 2, 'start').launch).is(true)
                expect(m.slots[2].focus).is(2)
            end)
        end)

        test.group('rearm', function()
            test.case('after a round the locks stay and every cursor sits on START', function(expect)
                local m = Menu.new(2)
                press(m, 1, 'jump')
                press(m, 1, 'jump')
                Menu.rearm(m)
                expect(Menu.controllerFor(m, 1)).is(1)
                expect(m.slots[1].focus).is(Menu.START)
                expect(m.slots[2].focus).is(Menu.START)
                expect(m.slots[2].card).is(2)
            end)
            test.case('a button still held from the round does not relaunch', function(expect)
                local m = Menu.new(2)
                Menu.rearm(m)
                local intents = nothing(m)
                intents[1] = intent({ jump = true })
                expect(Menu.update(m, intents).launch).is(false)
                Menu.update(m, nothing(m))
                expect(Menu.update(m, intents).launch).is(true)
            end)
        end)

        test.group('layout', function()
            test.case('the cursors outline their cards, p2 two px inside p1', function(expect)
                local views = Menu.layout(Menu.new(2))
                expect(views[1].cursor.x).is(-2)
                expect(views[1].cursor.y).is(74)
                expect(views[1].cursor.w).is(72)
                expect(views[1].cursor.h).is(92)
                expect(views[1].marker.x).is(26)
                expect(views[1].marker.y).is(64)
                expect(views[2].cursor.x).is(64)
                expect(views[2].cursor.y).is(76)
                expect(views[2].cursor.w).is(68)
                expect(views[2].cursor.h).is(88)
                expect(views[2].marker.x).is(90)
                expect(views[2].marker.y).is(64)
            end)
            test.case('both on START: nested outlines, markers side by side', function(expect)
                local m = Menu.new(2)
                press(m, 1, 'down')
                press(m, 2, 'down')
                local views = Menu.layout(m)
                expect(views[1].cursor.x).is(98)
                expect(views[1].cursor.y).is(174)
                expect(views[1].cursor.w).is(60)
                expect(views[1].cursor.h).is(28)
                expect(views[2].cursor.x).is(100)
                expect(views[2].cursor.y).is(176)
                expect(views[2].cursor.w).is(56)
                expect(views[2].cursor.h).is(24)
                expect(views[1].marker.x).is(112)
                expect(views[2].marker.x).is(128)
                expect(views[1].marker.y).is(164)
            end)
            test.case('a locked marker stays on the card while the cursor is on START', function(expect)
                local m = Menu.new(2)
                press(m, 1, 'jump')
                local views = Menu.layout(m)
                expect(views[1].cursor.y).is(174)
                expect(views[1].marker.x).is(26)
                expect(views[1].marker.y).is(64)
            end)
            test.case('two markers on one card share it', function(expect)
                local m = Menu.new(2)
                press(m, 2, 'left')
                local views = Menu.layout(m)
                expect(views[1].marker.x).is(18)
                expect(views[2].marker.x).is(34)
            end)
        end)
    end
end
